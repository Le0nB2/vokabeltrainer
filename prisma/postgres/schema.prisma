generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  displayName  String?
  passwordHash String
  role         String    @default("USER")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  decks        Deck[]
}

model Deck {
  id                  String      @id @default(uuid())
  userId              String?
  user                User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  targetLanguage      String      @default("en")
  sourceLanguage      String      @default("de")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  cards               Card[]
  reviewLogs          ReviewLog[]
  lastResultCorrect   Int?
  lastResultIncorrect Int?

  @@index([userId])
}

model Card {
  id                 String      @id @default(uuid())
  deckId             String
  deck               Deck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front              String
  back               String
  language           String      @default("en")
  notes              String?
  mnemonic           String?
  contextSentence    String?
  easeFactor         Float       @default(2.5)
  lapses             Int         @default(0)
  box                Int         @default(1)
  consecutiveCorrect Int         @default(0)
  dueDate            DateTime    @default(now())
  lastReviewed       DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  gapText            String?
  reviewLogs         ReviewLog[]
}

model ReviewLog {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  isCorrect Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Settings {
  id                    String  @id @default("default")
  minigamesEnabled      Boolean @default(true)
  minigameIntervalMin   Int     @default(50)
  minigameIntervalMax   Int     @default(75)
  speedMatchEnabled     Boolean @default(true)
  balloonPopEnabled     Boolean @default(true)
  reactionTesterEnabled Boolean @default(true)
  wordDropEnabled       Boolean @default(true)
  worksheetCount        Int     @default(0)
  notificationsEnabled  Boolean @default(false)
  speechLanguage        String  @default("en-GB")
  selectedModel         String  @default("gemini-3.6-flash")
}

model AiModel {
  id          String   @id
  name        String
  displayName String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiUsageLog {
  id          String   @id @default(uuid())
  apiKeyIndex Int
  isSuccess   Boolean
  endpoint    String
  errorReason String?
  createdAt   DateTime @default(now())
}
