"use server"

import prisma from "@/lib/prisma"
import { revalidatePath } from "next/cache"
import { addDays } from "date-fns"

export async function addCard(deckId: string, front: string, back: string, notes?: string) {
  const card = await prisma.card.create({
    data: {
      deckId,
      front,
      back,
      notes,
    }
  });
  revalidatePath(`/decks/${deckId}`);
  return card;
}

export async function addCardsBulk(deckId: string, cards: { front: string; back: string; notes?: string }[]) {
  const created = await prisma.card.createMany({
    data: cards.map(c => ({
      deckId,
      front: c.front,
      back: c.back,
      notes: c.notes,
      box: 1,
      dueDate: new Date(),
    }))
  });
  revalidatePath(`/decks/${deckId}`);
  return created;
}

export async function deleteCard(cardId: string, deckId: string) {
  await prisma.card.delete({
    where: { id: cardId }
  });
  revalidatePath(`/decks/${deckId}`);
}

// Leitner intervals
const getIntervalDays = (box: number): number => {
  switch (box) {
    case 1: return 1;
    case 2: return 2;
    case 3: return 4;
    case 4: return 7;
    case 5: return 14;
    case 6: return 30;
    case 7: return 90;
    default: return 1;
  }
}

export async function updateCardProgress(cardId: string, deckId: string, isCorrect: boolean) {
  const card = await prisma.card.findUnique({ where: { id: cardId } });
  if (!card) throw new Error("Card not found");

  const now = new Date();
  let newBox = card.box;
  let newConsecutive = card.consecutiveCorrect;
  let nextDueDays = 1;

  if (isCorrect) {
    newBox = Math.min(7, card.box + 1);
    newConsecutive += 1;
    nextDueDays = getIntervalDays(newBox);
  } else {
    newBox = 1;
    newConsecutive = 0;
    nextDueDays = 1;
  }

  const dueDate = addDays(now, nextDueDays);

  const updatedCard = await prisma.card.update({
    where: { id: cardId },
    data: {
      box: newBox,
      consecutiveCorrect: newConsecutive,
      lastReviewed: now,
      dueDate,
    }
  });

  return updatedCard;
}
