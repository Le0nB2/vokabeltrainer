# Google Gemini API (einzelner Key oder kommagetrennte Liste für Rotation)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEYS=key1,key2,key3

# Passwort für den geschützten Einstellungsbereich
SETTINGS_PASSWORD=your_settings_password_here

# Optional: Web-App Gesamtzugriffsschutz (Session-Cookie Login)
AUTH_USER=admin
AUTH_PASSWORD=your_app_password_here

# Kryptografisches Geheimnis für Session-Tokens (mindestens 32 Zeichen / Hex)
AUTH_SECRET=your_random_32_byte_secret_here

# Optional: Explizites Erzwingen von Secure Cookies (true/false)
# COOKIE_SECURE=true

# API-Token für Home Assistant REST Sensor Integration (/api/notifications/due-count)
NOTIFICATION_API_TOKEN=your_secret_home_assistant_token_here
